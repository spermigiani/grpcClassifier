<source filename="models/busquedaSecuencial.dals" content="/*&#x000a;Ejemplo tomado del paper, adaptado a la sintaxis corriente de DynAlloy,&#x000a;*/&#x000a;open util/boolean&#x000a;&#x000a;sig Elem { }&#x000a;&#x000a;sig Seq {&#x000a;  idx: set Int,&#x000a;  length: Int,&#x000a;  at: idx -&gt; one Elem&#x000a;} {&#x000a;    // Constraints to ensure the sequence is well-formed&#x000a;    all i: idx | i &gt;= 0 and i &lt; length&#x000a;    length = #idx&#x000a;}&#x000a;&#x000a;&#x000a;program busquedaSecuencial[s: Seq, elem: Elem, out: Bool] var [i:Int]{&#x000a;  assume (gte[s.length,0]);&#x000a;  out := False;&#x000a;  i := 0; &#x000a;  while ( i&lt;s.length and   out = boolean/False) do { &#x000a;    if (s.at[i]=elem) {&#x000a;       out := True //pueden checkear un contraejemplo cambiando esta linea por False&#x000a;    };&#x000a;    i:= add[i,1]&#x000a;  } &#x000a;}&#x000a;&#x000a;&#x000a;&#x000a;run busquedaSecuencial"/>

